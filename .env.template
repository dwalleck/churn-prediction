# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# S3 Buckets
S3_DATA_BUCKET=your-churn-data-bucket
S3_MODEL_BUCKET=your-churn-models-bucket

# DynamoDB Tables
DYNAMODB_SCORES_TABLE=churn-scores
DYNAMODB_EVENTS_TABLE=churn-events
DYNAMODB_METADATA_TABLE=model-metadata

# Lambda Configuration
LAMBDA_FUNCTION_NAME=churn-scoring-pipeline
LAMBDA_MEMORY_SIZE=3008
LAMBDA_TIMEOUT=900

# ECS/Fargate Configuration
ECS_CLUSTER_NAME=churn-cluster
ECS_SERVICE_NAME=churn-dashboard
ECS_TASK_FAMILY=churn-dashboard-task
ECR_REPOSITORY=churn-dashboard

# Application Configuration
MODEL_S3_KEY=models/active/model.pkl
CHURN_ENV=production
